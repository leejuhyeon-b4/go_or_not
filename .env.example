# 이 파일을 복사해서 .env 를 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 되어 커밋되지 않습니다. .env.example 만 커밋됩니다.

# KOPIS 공연예술통합전산망 OpenAPI — data.go.kr "예술경영지원센터_공연예술통합전산망"
#   활용신청 API 별로 키가 다르게 나온다. 이메일에서 각각 복사.
#   LIST=공연목록/검색(pblprfr), DETAIL=공연상세(pblprfr/{id}, prfplc 도 이 키)
KOPIS_API_KEY_LIST=
KOPIS_API_KEY_DETAIL=

# Supabase (연결 시 채우기)
#   URL·publishable 키: 대시보드 → Project Settings → API
#   publishable 키(sb_publishable_…)는 브라우저 노출 전제라 seed.remote.js 에 박혀도 된다.
#   service_role 키는 서버 전용 — 절대 커밋·브라우저 노출 금지.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
